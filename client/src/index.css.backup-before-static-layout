* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100vh;
}

body {
  font-family: Inter, system-ui, sans-serif;
  background: #05070f;
  color: #f5f1e8;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.theme-background {
  position: fixed;
  inset: 0;
  z-index: 0;
  opacity: 0.96;
}

.theme-background img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.95) contrast(1.08);
}

.theme-overlay {
  position: fixed;
  inset: 0;
  z-index: 1;
}

.theme-shell {
  position: relative;
  z-index: 2;
  min-height: 100vh;
}

.theme-shell.theme-transitioning::after {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(circle at 12% 10%, rgba(255, 255, 255, 0.12), transparent 24%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 48%);
  opacity: 1;
  animation: theme-morph 0.52s ease-out forwards;
}

@keyframes theme-morph {
  from {
    transform: translate(0, 0) scale(1);
    opacity: 1;
  }
  to {
    transform: translate(16px, 16px) scale(1.02);
    opacity: 0;
  }
}

.app-shell {
  position: relative;
  z-index: 2;
  padding: clamp(24px, 3vw, 48px);
}

.top-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  position: relative;
  margin-bottom: 2rem;
  color: rgba(245, 241, 232, 0.78);
}

.top-status-group {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.top-left {
  align-items: baseline;
}

.top-status-time {
  font-size: 0.92rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(245, 241, 232, 0.92);
}

.theme-switcher-button {
  padding: 0.8rem 1rem;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: rgba(8, 12, 20, 0.7);
  color: #f5f1e8;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.78rem;
}

.top-center {
  font-size: 0.95rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.status-badge {
  color: #f97316;
  margin-right: 0.35rem;
}

.source-label {
  font-size: 0.92rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(245, 241, 232, 0.85);
}

.theme-picker-panel {
  position: absolute;
  top: calc(100% + 12px);
  left: 0;
  display: grid;
  gap: 10px;
  padding: 14px;
  min-width: 220px;
  border-radius: 22px;
  background: rgba(10, 12, 18, 0.92);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  z-index: 3;
}

.theme-picker-item {
  width: 100%;
  border: none;
  background: transparent;
  padding: 0.8rem 1rem;
  text-align: left;
  color: #f5f1e8;
  border-radius: 14px;
  transition: background 0.2s ease;
}

.theme-picker-item:hover,
.theme-picker-item.active {
  background: rgba(255, 255, 255, 0.08);
}

.theme-main-grid {
  display: grid;
  gap: clamp(24px, 5vw, 40px);
  grid-template-columns: minmax(320px, 1.1fr) minmax(320px, 0.9fr);
  align-items: center;
  min-height: calc(100vh - 260px);
}

.theme-copy-column {
  max-width: 680px;
  display: grid;
  gap: 28px;
}

.theme-headline {
  display: grid;
  gap: 0.5rem;
  text-transform: uppercase;
}

.theme-headline-line {
  font-size: clamp(3rem, 5vw, 5rem);
  line-height: 0.92;
  letter-spacing: 0.12em;
  font-weight: 800;
  margin: 0;
}

.theme-headline-accent {
  color: var(--accent-color, #f5f1e8);
}

.theme-tagline {
  max-width: 620px;
  margin: 0;
  color: rgba(245, 241, 232, 0.84);
  font-size: clamp(1rem, 1.1vw, 1.2rem);
  line-height: 1.7;
}

.theme-description {
  color: rgba(245, 241, 232, 0.68);
  font-size: 0.98rem;
  line-height: 1.8;
  max-width: 560px;
}

.lyrics-panel {
  display: grid;
  gap: 0.9rem;
  padding: 1.4rem;
  border-radius: 28px;
  background: rgba(8, 12, 18, 0.68);
  border: 1px solid rgba(255, 255, 255, 0.08);
  max-width: 520px;
  min-height: 250px;
}

.lyrics-header {
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 0.18em;
  color: rgba(245, 241, 232, 0.78);
}

.lyrics-content,
.lyrics-empty {
  font-size: 0.95rem;
  line-height: 1.8;
  color: rgba(245, 241, 232, 0.88);
  max-height: 260px;
  overflow: auto;
}

.theme-hero-column {
  display: grid;
  place-items: center;
}

.theme-hero-wrapper {
  width: min(100%, 520px);
  aspect-ratio: 1 / 1;
}

.theme-hero-card {
  width: 100%;
  height: 100%;
  border-radius: 32px;
  overflow: hidden;
  display: grid;
  place-items: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: transform 0.36s ease, box-shadow 0.36s ease;
}

.theme-hero-card.theme-hero-active {
  transform: scale(1.02);
  box-shadow: 0 40px 90px rgba(0, 0, 0, 0.28);
}

.theme-hero-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.theme-player-zone {
  display: grid;
  justify-items: center;
  gap: 1.4rem;
  margin-top: 2rem;
}

.music-player-card {
  width: min(840px, 100%);
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 1.4rem;
  align-items: center;
  padding: 1.6rem;
  border-radius: 32px;
  background: rgba(10, 14, 24, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 40px 90px rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(var(--player-blur, 16px));
}

.player-artwork {
  width: 144px;
  height: 144px;
  min-width: 144px;
  border-radius: 26px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.player-artwork img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.player-artwork-fallback {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: rgba(245, 241, 232, 0.58);
  font-size: 0.92rem;
}

.player-details {
  display: grid;
  gap: 1rem;
}

.player-title {
  font-size: clamp(1.25rem, 2vw, 1.8rem);
  font-weight: 800;
  line-height: 1.05;
}

.player-subtitle {
  color: rgba(245, 241, 232, 0.72);
  font-size: 0.98rem;
}

.player-progress-group {
  display: grid;
  gap: 0.75rem;
}

.player-progress-group span {
  color: rgba(245, 241, 232, 0.76);
  font-size: 0.92rem;
}

.player-progress {
  width: 100%;
  appearance: none;
  height: 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  outline: none;
}

.player-progress::-webkit-slider-thumb {
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #f5f1e8;
  border: 2px solid rgba(0, 0, 0, 0.1);
}

.player-controls {
  display: flex;
  gap: 1rem;
}

.player-control-button {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
  color: #f5f1e8;
  font-size: 1rem;
  display: grid;
  place-items: center;
}

.player-control-play {
  width: 76px;
  height: 76px;
  background: #f5f1e8;
  color: #111827;
  font-size: 1.1rem;
}

.start-engine-button {
  border: none;
  border-radius: 999px;
  padding: 1rem 2.2rem;
  min-width: 250px;
  color: #08101f;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 800;
}

.theme-status-copy {
  color: rgba(245, 241, 232, 0.64);
  font-size: 0.95rem;
  text-align: center;
  max-width: 760px;
}

@media (max-width: 1100px) {
  .theme-main-grid {
    grid-template-columns: 1fr;
  }

  .theme-player-zone {
    margin-top: 1.5rem;
  }

  .music-player-card {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .player-artwork {
    margin: 0 auto;
  }

  .player-controls {
    justify-content: center;
  }
}

@media (max-width: 720px) {
  .app-shell {
    padding: 18px;
  }

  .top-status-bar {
    flex-direction: column;
    align-items: flex-start;
  }

  .theme-headline-line {
    font-size: clamp(2.2rem, 8vw, 3.4rem);
  }

  .lyrics-panel {
    max-width: 100%;
    padding: 1.2rem;
  }

  .player-progress-group {
    gap: 0.5rem;
  }

  .player-progress {
    height: 5px;
  }
}
